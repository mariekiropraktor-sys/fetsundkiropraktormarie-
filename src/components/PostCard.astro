---
import { temaNavn } from "../data/site";

interface Props {
  slug: string;
  title: string;
  tema: string;
  date: Date;
  image?: string;
  visBilde?: boolean;
}
const { slug, title, tema, date, image, visBilde = true } = Astro.props;
const dato = date.toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" });
---

<a class="card card-link post" href={`/${slug}/`} data-tema={tema}>
  {visBilde && image && <img src={image} alt="" loading="lazy" class="post__bilde" />}
  <span class="eyebrow">{temaNavn[tema]}</span>
  <h3 class="post__tittel">{title}</h3>
  <span class="post__dato muted">{dato}</span>
</a>

<style>
  .post {
    padding: 0 0 24px;
    overflow: hidden;
  }
  .post > :not(img) {
    margin-inline: 24px;
  }
  .post__bilde {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-bottom: 12px;
    background: var(--line);
  }
  .post .eyebrow {
    margin-top: 20px;
  }
  .post__bilde + .eyebrow {
    margin-top: 0;
  }
  .post__tittel {
    font-size: 21px;
    line-height: 1.3;
  }
  .post__dato {
    font-size: 14px;
    margin-top: auto;
  }
</style>
