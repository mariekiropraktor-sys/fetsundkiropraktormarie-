---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Fant ikke siden" description="Siden du lette etter finnes ikke.">
  <section class="wrap side-topp innhold">
    <span class="eyebrow">404</span>
    <h1 class="h1">Denne siden finnes ikke</h1>
    <p class="lead">Kanskje den har flyttet. Prøv en av disse:</p>
    <div class="btn-row">
      <a class="btn" href="/">Til forsiden</a>
      <a class="btn btn--ghost" href="/svimmelhet/">Svimmelhet</a>
      <a class="btn btn--ghost" href="/blogg/">Blogg</a>
    </div>
  </section>
</Layout>
